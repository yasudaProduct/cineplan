{
  "name": "@cinema/ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler-state",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:st": "wrangler deploy --env st",
    "deploy:prod": "wrangler deploy --env prod"
  },
  "dependencies": {
    "@cinema/shared": "workspace:*",
    "hono": "^4.12.28"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "wrangler": "^4.54.0"
  }
}
