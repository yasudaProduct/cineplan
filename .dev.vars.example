# .dev.vars.example — このファイルをコピーして .dev.vars を作成し、実値を記入する。
# .dev.vars は gitignore 対象（コミット禁止）。詳細は docs/16_human-setup-guide.md §2。
APP_ENV=local

# LLM 抽出（P1 で使用。既定プロバイダ Google Gemini。ADR-0011）。
# aistudio.google.com で無料発行（クレカ不要）。
LLM_PROVIDER=gemini
GEMINI_API_KEY=xxxxxxxx
# プロバイダ差し替え時（抽出クライアントは抽象化）:
# LLM_PROVIDER=workers-ai  # Cloudflare Workers AI（キー不要・バインディング）
# LLM_PROVIDER=anthropic   # ANTHROPIC_API_KEY=sk-ant-...

# 駅すぱあと API（移動時間行列。P4-6 で使用）。ローカルは transit-stub 経由でも可。
TRANSIT_API_BASE=http://localhost:1080
# EKISPERT_API_KEY=xxxxxxxx

# Slack 通知（検証NG・取込失敗。P1-7 で使用）。ローカルは slack-stub を指す。
SLACK_WEBHOOK_URL=http://localhost:1081/webhook
